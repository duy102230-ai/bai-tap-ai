generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  exams     Exam[]
  questions Question[]
}

// Ngân hàng câu hỏi — tái sử dụng cho nhiều đề
model Question {
  id          String   @id @default(cuid())
  teacherId   String
  subject     String // Môn học, vd: Toán, Văn
  topic       String? // Chủ đề/chương
  type        String // "multiple_choice" | "essay" | "fill_blank"
  content     String // Nội dung câu hỏi
  imageUrl    String? // Ảnh minh họa nếu có (hình gốc trong đề)
  options     String? // JSON string: ["A. ...", "B. ...", "C. ...", "D. ..."]
  answer      String // Đáp án đúng (vd: "A" hoặc text đáp án tự luận)
  explanation String? // Giải thích đáp án
  createdAt   DateTime @default(now())

  teacher      Teacher        @relation(fields: [teacherId], references: [id])
  examQuestions ExamQuestion[]
}

// Đề thi/bài tập được tạo ra từ ngân hàng câu hỏi
model Exam {
  id              String   @id @default(cuid())
  teacherId       String
  title           String
  description     String?
  sourceFile      String? // Tên/đường dẫn file ảnh/PDF gốc dùng để tạo đề
  shareCode       String   @unique // Mã code ngắn để học sinh vào làm bài qua link
  isPublished     Boolean  @default(false)
  durationMinutes Int? // Giới hạn thời gian làm bài (phút); null = không giới hạn
  createdAt       DateTime @default(now())

  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  questions   ExamQuestion[]
  submissions Submission[]
}

// Bảng nối Exam - Question (nhiều-nhiều, có thứ tự)
model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  order      Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

// Học sinh làm bài không cần tài khoản — chỉ nhập tên
model Submission {
  id          String   @id @default(cuid())
  examId      String
  studentName String
  answers     String // JSON string: { questionId: answer }
  score       Float?
  totalPoints Int?
  submittedAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}
